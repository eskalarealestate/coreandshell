# Supabase project settings → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Prefer the service role key if you switch RLS to real per-user policies later.
# For now (single fixed user, permissive RLS), the anon key is enough — it is
# only ever used from server-only code (Server Actions), never sent to the browser.
SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
